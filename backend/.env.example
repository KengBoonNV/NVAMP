# Comma-separated emails. Owners get the Admin role and can import backups (/import.html).
NVAMP_OWNER_EMAILS=
# Comma-separated emails of editor-level accounts (approvers).
NVAMP_ADMIN_EMAILS=
# Comma-separated emails of accounts that may view but never write.
NVAMP_READONLY_EMAILS=
# Comma-separated email domains allowed to sign in (empty = any SSO account).
NVAMP_ALLOWED_DOMAINS=ninjavan.co
# API key(s) for raising tickets from other systems (Google Chat). Comma-separated to rotate; 24+ chars each.
NVAMP_TICKETS_API_KEY=   # secret
