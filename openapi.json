  "/api/db/coll": {
   "get": {
    "summary": "List a collection's documents; with `since`, only those changed after it plus the current ids.",
    "description": "With `since` (ms, from a previous reply's `t`), only documents changed after it are\nreturned, plus `ids` \u2014 every id now in the collection \u2014 so the caller can drop deletions.\nLarge collections (thousands of work orders) then cost a few KB per change, not MBs.",
    "operationId": "get_coll_api_db_coll_get",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Path"
      }
     },
     {
      "name": "orderBy",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Orderby"
      }
     },
     {
      "name": "dir",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "asc",
       "title": "Dir"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 5000,
         "minimum": 1
        },
        {
         "type": "null"
        }
       ],
       "title": "Limit"
      }
     },
     {
      "name": "since",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "minimum": 0
        },
        {
         "type": "null"
        }
       ],
       "title": "Since"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CollOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
