     "msg",
     "type"
    ],
    "title": "ValidationError"
   },
   "Viewer": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "email": {
      "type": "string",
      "title": "Email"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "isOwner": {
      "type": "boolean",
      "title": "Isowner"
     },
     "canEdit": {
      "type": "boolean",
      "title": "Canedit"
     },
     "canWrite": {
      "type": "boolean",
      "title": "Canwrite"
     }
    },
    "type": "object",
    "required": [
     "id",
     "email",
     "name",
     "isOwner",
     "canEdit",
     "canWrite"
    ],
    "title": "Viewer"
   }
  }
 }
}