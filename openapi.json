{
 "openapi": "3.1.0",
 "info": {
  "title": "NVAMP",
  "version": "1.0",
  "description": "NVAMP maintenance platform API: a document store, file uploads and identity behind Google SSO. Routes under /api/integrations use an API key (X-API-Key) instead of Google SSO."
 },
