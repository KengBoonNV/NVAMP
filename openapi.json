{
 "openapi": "3.1.0",
 "info": {
  "title": "NVAMP",
  "version": "1.0",
  "description": "NVAMP maintenance platform API: a document store, file uploads and identity behind Google SSO."
 },
 "paths": {
  "/health": {
   "get": {
    "summary": "Readiness probe; returns ok when the service is up.",
    "operationId": "health_health_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Health"
        }
       }
      }
     }
    }
   }
  },
  "/api/me": {
   "get": {
    "summary": "Who is signed in (from Google SSO) and their NVAMP owner/editor/write flags.",
    "operationId": "me_api_me_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Viewer"
        }
       }
      }
     }
    }
   }
  },
  "/api/users/profiles": {
   "post": {
    "summary": "Display names for a list of user ids (emails).",
    "operationId": "profiles_api_users_profiles_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ProfilesIn"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ProfilesOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/users/search": {
   "get": {
    "summary": "Find people who have used NVAMP or hold a role, by name or email.",
    "description": "People who have opened NVAMP (members) plus anyone already given a role.\nTyping a full email address also offers that address, so an admin can add someone\nbefore their first visit.",
    "operationId": "search_api_users_search_get",
    "parameters": [
     {
      "name": "q",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "",
       "title": "Q"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SearchOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/db/sigs": {
   "get": {
    "summary": "Change counter per collection; the page polls this to know what to re-read.",
    "operationId": "sigs_api_db_sigs_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Sigs"
        }
       }
      }
     }
    }
   }
  },
  "/api/db/doc": {
   "get": {
    "summary": "Read one document by its slash path.",
    "operationId": "get_doc_api_db_doc_get",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Path"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DocOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "put": {
    "summary": "Create or fully replace one document.",
    "operationId": "set_doc_api_db_doc_put",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Path"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DocIn"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "patch": {
    "summary": "Merge fields into an existing document (nested objects merge, arrays replace).",
    "operationId": "update_doc_api_db_doc_patch",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Path"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DocIn"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "delete": {
    "summary": "Delete one document.",
    "operationId": "delete_doc_api_db_doc_delete",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Path"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/db/coll": {
   "get": {
    "summary": "List the documents in a collection, optionally ordered and limited.",
    "operationId": "get_coll_api_db_coll_get",
    "parameters": [
     {
      "name": "path",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Path"
      }
     },
     {
      "name": "orderBy",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Orderby"
      }
     },
     {
      "name": "dir",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "asc",
       "title": "Dir"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer",
         "maximum": 5000,
         "minimum": 1
        },
        {
         "type": "null"
        }
       ],
       "title": "Limit"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CollOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/blob": {
   "post": {
    "summary": "Upload a photo, signature or PDF (max 20 MB).",
    "operationId": "upload_api_blob_post",
    "requestBody": {
     "content": {
      "multipart/form-data": {
       "schema": {
        "$ref": "#/components/schemas/Body_upload_api_blob_post"
       }
      }
     },
     "required": true
    },
    "responses": {
     "201": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AssetOut"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/blob/{asset_id}": {
   "get": {
    "summary": "Download an uploaded file.",
    "operationId": "get_blob_api_blob__asset_id__get",
    "parameters": [
     {
      "name": "asset_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Asset Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {}
       },
       "application/octet-stream": {}
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "delete": {
    "summary": "Delete an uploaded file.",
    "operationId": "delete_blob_api_blob__asset_id__delete",
    "parameters": [
     {
      "name": "asset_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Asset Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Ok"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/admin/import": {
   "post": {
    "summary": "Owner only: load an NVAMP full-backup JSON file (upsert by id).",
    "description": "Load an `nvamp-backup-YYYY-MM-DD.json` (Team & settings \u2192 Back up all data).\nOwner only. Documents are upserted by id; nothing is deleted.",
    "operationId": "import_backup_api_admin_import_post",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ImportOut"
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "schemas": {
   "AssetOut": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "url": {
      "type": "string",
      "title": "Url"
     },
     "sizeBytes": {
      "type": "integer",
      "title": "Sizebytes"
     },
     "contentType": {
      "type": "string",
      "title": "Contenttype"
     }
    },
    "type": "object",
    "required": [
     "id",
     "url",
     "sizeBytes",
     "contentType"
    ],
    "title": "AssetOut"
   },
   "Body_upload_api_blob_post": {
    "properties": {
     "file": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "File"
     }
    },
    "type": "object",
    "required": [
     "file"
    ],
    "title": "Body_upload_api_blob_post"
   },
   "CollOut": {
    "properties": {
     "docs": {
      "items": {
       "$ref": "#/components/schemas/DocItem"
      },
      "type": "array",
      "title": "Docs"
     }
    },
    "type": "object",
    "required": [
     "docs"
    ],
    "title": "CollOut"
   },
   "DocIn": {
    "properties": {
     "data": {
      "additionalProperties": true,
      "type": "object",
      "title": "Data"
     }
    },
    "type": "object",
    "required": [
     "data"
    ],
    "title": "DocIn"
   },
   "DocItem": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "data": {
      "additionalProperties": true,
      "type": "object",
      "title": "Data"
     }
    },
    "type": "object",
    "required": [
     "id",
     "data"
    ],
    "title": "DocItem"
   },
   "DocOut": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "exists": {
      "type": "boolean",
      "title": "Exists"
     },
     "data": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Data"
     }
    },
    "type": "object",
    "required": [
     "id",
     "exists"
    ],
    "title": "DocOut"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Health": {
    "properties": {
     "status": {
      "type": "string",
      "title": "Status"
     }
    },
    "type": "object",
    "required": [
     "status"
    ],
    "title": "Health"
   },
   "Hit": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "email": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Email"
     },
     "isMe": {
      "type": "boolean",
      "title": "Isme",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "id",
     "name"
    ],
    "title": "Hit"
   },
   "ImportOut": {
    "properties": {
     "ok": {
      "type": "boolean",
      "title": "Ok"
     },
     "documents": {
      "type": "integer",
      "title": "Documents"
     },
     "counts": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Counts"
     }
    },
    "type": "object",
    "required": [
     "ok",
     "documents",
     "counts"
    ],
    "title": "ImportOut"
   },
   "Ok": {
    "properties": {
     "ok": {
      "type": "boolean",
      "title": "Ok"
     }
    },
    "type": "object",
    "required": [
     "ok"
    ],
    "title": "Ok"
   },
   "Profile": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name"
     },
     "email": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Email"
     }
    },
    "type": "object",
    "required": [
     "name"
    ],
    "title": "Profile"
   },
   "ProfilesIn": {
    "properties": {
     "ids": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Ids"
     }
    },
    "type": "object",
    "required": [
     "ids"
    ],
    "title": "ProfilesIn"
   },
   "ProfilesOut": {
    "properties": {
     "profiles": {
      "additionalProperties": {
       "$ref": "#/components/schemas/Profile"
      },
      "type": "object",
      "title": "Profiles"
     }
    },
    "type": "object",
    "required": [
     "profiles"
    ],
    "title": "ProfilesOut"
   },
   "SearchOut": {
    "properties": {
     "hits": {
      "items": {
       "$ref": "#/components/schemas/Hit"
      },
      "type": "array",
      "title": "Hits"
     }
    },
    "type": "object",
    "required": [
     "hits"
    ],
    "title": "SearchOut"
   },
   "Sigs": {
    "properties": {
     "sigs": {
      "additionalProperties": {
       "type": "integer"
      },
      "type": "object",
      "title": "Sigs"
     },
     "t": {
      "type": "integer",
      "title": "T"
     }
    },
    "type": "object",
    "required": [
     "sigs",
     "t"
    ],
    "title": "Sigs"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
