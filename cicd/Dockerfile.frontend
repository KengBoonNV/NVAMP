# NVAMP frontend: the single-page app plus its runtime adapter, served by nginx on port 80.
# No build step — frontend/index.html is produced by `node tools/build-frontend.mjs`
# from ../app/index.html and committed. /api is routed to the backend by the ingress.
FROM nginx:stable-alpine
RUN apk upgrade --no-cache
COPY frontend/ /usr/share/nginx/html/
COPY cicd/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
